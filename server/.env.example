# Copy this file to ".env" in the same folder and fill in the values.
# Never commit .env — it holds secrets. (.gitignore already excludes it.)
# Step-by-step help for every value: SETUP.md in the project folder.

NODE_ENV=development
PORT=4000

# Where the website runs (for CORS) and its public address (for email links)
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# ── Required ────────────────────────────────────────────────────────
# MongoDB Atlas connection string (SETUP.md step 1)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/travel-tracker?retryWrites=true&w=majority

# A long random secret that signs login tokens (SETUP.md step 2). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

# ── Optional: email (SETUP.md step 3) ───────────────────────────────
# Leave empty during development: email links are printed in the terminal instead.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Travel Tracker

# ── Optional: profile photos (SETUP.md step 4) ──────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Hosting only ────────────────────────────────────────────────────
# "true" on Render: the API also serves the built website
SERVE_CLIENT=false
